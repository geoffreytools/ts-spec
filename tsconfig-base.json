{
    "compilerOptions": {
        "noEmit": true,
        "noEmitOnError": true,
        "noErrorTruncation": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2015", "DOM"],
        "target": "ES2015",
        "strictFunctionTypes": true,
        "noImplicitAny": true,
        "strict": true
    }
}